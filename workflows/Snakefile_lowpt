import os
username = os.getenv("USER")

config = {
    'output_path': "output/lowpt/",
    'dataset_location': "coffea4bees/metadata/datasets_HH4b_2024_v2.yml",
    "analysis_container": "/cvmfs/unpacked.cern.ch/gitlab-registry.cern.ch/cms-cmu/barista:latest",
    'dataset' : [ 'data', 'TTToSemiLeptonic', 'TTTo2L2Nu', 'TTToHadronic'],
    'year': 'UL18'
}

# Include the base JCM computation rules with this file's config
module computeJCM:
    snakefile: "Snakefile_computeJCM"
    config: config

use rule * from computeJCM

rule all_lowpt:
    input:
        f"{config['output_path']}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2_lowpt.yml"
    default_target: True

rule create_metadata:
    input: f"{config['output_path']}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2.yml"
    output: f"{config['output_path']}HH4b_nominalJCM.yml"
    shell:
        """
        echo "Modifying metadata file to include new JCM"
        sed -e 's|  JCM_file.*|  JCM_file: output/lowpt/JCM_2024_v2/jetCombinatoricModel_SB_2024_v2.yml|' -e 's|JCM_lowpt_file|#JCM_lowpt_file|' -e 's|apply_JCM_lowpt: true|apply_JCM_lowpt: false|' coffea4bees/analysis/metadata/HH4b_lowpt_2024_v2.yml > {output}
        cat {output}
        """

use rule analysis_processor from analysis as analysis_lowpt with:
    input: f"{config['output_path']}HH4b_nominalJCM.yml"
    output: f"{config['output_path']}histAll_nominalJCM_lowpt_{{dataset}}.coffea"
    params:
        datasets = "{dataset}",
        years = config['year'],
        metadata = lambda wildcards, input: input[0],
        processor = "coffea4bees/analysis/processors/processor_HH4b_lowpt.py",
        datasets_file = config['dataset_location'],
        blind = False,
        run_performance = False,
        extra_arguments = "",
        username = username
    log: f"{config['output_path']}logs/analysis_all_{{dataset}}.log"

use rule merging_coffea_files from analysis as merging_lowpt_files with:
    input: expand(f"{config['output_path']}histAll_nominalJCM_lowpt_{{dataset}}.coffea", dataset=config['dataset'])
    output: f"{config['output_path']}histAll_nominalJCM_lowpt.coffea"
    params:
        run_performance = False
    log: f"{config['output_path']}logs/merging_all_lowpt.log" 

use rule make_JCM from analysis as make_new_JCM_lowpt with:
    input: f"{config['output_path']}histAll_nominalJCM_lowpt.coffea"
    output: f"{config['output_path']}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2_lowpt.yml"
    params:
        extra_arguments = "--lowpt",
        tag = "2024_v2",
        output_dir = f"{config['output_path']}"
    log: f"{config['output_path']}logs/make_JCM_lowpt.log"
