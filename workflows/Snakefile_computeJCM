import os
username = os.getenv("USER")

output_path = "output/lowpt/"
config = {
    'dataset_location': "coffea4bees/metadata/datasets_HH4b_2024_v2.yml",
    "analysis_container": "/cvmfs/unpacked.cern.ch/gitlab-registry.cern.ch/cms-cmu/barista:latest",
    'dataset' : [ 'data', 'TTToSemiLeptonic', 'TTTo2L2Nu', 'TTToHadronic'],
    'year': 'UL18'
}

rule all:
    input:
        # f"{output_path}histAll_nominalJCM_lowpt.coffea"
        f"{output_path}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2_lowpt.yml"

### Including modules
module analysis:
    snakefile: "rules/analysis.smk"
    config: config

use rule analysis_processor from analysis as analysis_noJCM with:
    output: f"{output_path}histAll_NoJCM.coffea"
    params:
        datasets = config['dataset'],
        years = config['year'],
        metadata = "coffea4bees/analysis/metadata/HH4b_noJCM.yml",
        processor = "coffea4bees/analysis/processors/processor_HH4b.py",
        datasets_file = config['dataset_location'],
        blind = False,
        run_performance = False,
        extra_arguments = "",
        username = username
    log: f"{output_path}logs/analysis_all.log"


use rule make_JCM from analysis as make_new_JCM with:
    input: f"{output_path}histAll_NoJCM.coffea"
    output: f"{output_path}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2.yml"
    params:
        output_dir = f"{output_path}JCM_2024_v2/"
    log: f"{output_path}logs/make_JCM.log"

rule create_metadata:
    input: f"{output_path}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2.yml"
    output: f"{output_path}HH4b_nominalJCM.yml"
    shell:
        """
        echo "Modifying metadata file to include new JCM"
        sed -e 's|  JCM_file.*|  JCM_file: output/lowpt/JCM_2024_v2/jetCombinatoricModel_SB_2024_v2.yml|' -e 's|JCM_lowpt_file|#JCM_lowpt_file|' -e 's|apply_JCM_lowpt: true|apply_JCM_lowpt: false|' coffea4bees/analysis/metadata/HH4b_lowpt_2024_v2.yml > {output}
        cat {output}
        """

use rule analysis_processor from analysis as analysis_lowpt with:
    input: f"{output_path}HH4b_nominalJCM.yml"
    output: f"{output_path}histAll_nominalJCM_lowpt_{{dataset}}.coffea"
    params:
        datasets = "{dataset}",
        years = config['year'],
        metadata = lambda wildcards, input: input[0],
        processor = "coffea4bees/analysis/processors/processor_HH4b_lowpt.py",
        datasets_file = config['dataset_location'],
        blind = False,
        run_performance = False,
        extra_arguments = "",
        username = username
    log: f"{output_path}logs/analysis_all_{{dataset}}.log"

use rule merging_coffea_files from analysis as merging_lowpt_files with:
    input: expand(f"{output_path}histAll_nominalJCM_lowpt_{{dataset}}.coffea", dataset=config['dataset'])
    output: f"{output_path}histAll_nominalJCM_lowpt.coffea"
    params:
        run_performance = False
    log: f"{output_path}logs/merging_all_lowpt.log" 

use rule make_JCM from analysis as make_new_JCM_lowpt with:
    input: f"{output_path}histAll_nominalJCM_lowpt.coffea"
    output: f"{output_path}JCM_2024_v2/jetCombinatoricModel_SB_2024_v2_lowpt.yml"
    params:
        output_dir = f"{output_path}"
    log: f"{output_path}logs/make_JCM_lowpt.log"